  "files": [],
  "idx": "725",
  "list_title": "청년비전캠프는 공모전 참가자만 신청할 수 있나요?",
  "image_local": null
 },
 {
  "url": "http://tjpark.postech.ac.kr/08_youth/04.php?idx=724&pg_mode=View&bid=y_qna&page=1&sw=",
  "title": null,
  "meta": {
   "posted": "2018-08-10",
