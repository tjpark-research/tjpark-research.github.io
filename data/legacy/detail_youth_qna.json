  "sections": [
   {
    "heading": null,
    "paragraphs": [
     "연구소에서 주최하는 공모전은 전국 대학생 및 대학원생(재학, 휴학)에게 모두 열려있는 공모전입니다."
    ]
   }
  ],
  "images": [],
  "files": [],
